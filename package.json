{
  "name": "carla-ai",
  "version": "1.0.0",
  "description": "Discord bot that manages Google Tasks and Google Calendar with slash commands and cron-scheduled reminders.",
  "private": true,
  "license": "MIT",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "register": "tsx src/deploy-commands.ts",
    "register:prod": "node dist/deploy-commands.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "chrono-node": "^2.7.7",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.5",
    "googleapis": "^144.0.0",
    "luxon": "^3.5.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
