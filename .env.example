# Copy this file to .env and fill it in. Never commit .env.

# --- Discord (https://discord.com/developers/applications) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands to one server (updates instantly). Leave empty for global commands.
DISCORD_GUILD_ID=
# Your own Discord user ID. Enables the owner-only /stats command.
OWNER_ID=

# --- Google Cloud (OAuth client of type "Desktop app") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost

# --- Security ---
# 64 hex characters (32 bytes). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# --- Misc ---
DATABASE_PATH=./data/carla.db
DEFAULT_TIMEZONE=America/New_York
